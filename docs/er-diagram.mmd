    BundesligaPlayer ||--o{ MatchEvent : "involved in"
    BundesligaPlayer ||--o{ DraftPick : "drafted as"
    BundesligaPlayer ||--o{ WaiverClaim : "in or out"
    BundesligaPlayer ||--o{ DroppedPlayer : dropped
    BundesligaPlayer ||--o{ Transfer : "in or out"

