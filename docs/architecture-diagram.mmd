    classDef db fill:#fce7f3,stroke:#be185d,color:#831843
    classDef ci fill:#ede9fe,stroke:#6d28d9,color:#4c1d95
    classDef container fill:#f1f5f9,stroke:#475569,color:#1e293b

    class SPA client
    class Controllers,Hubs,Services,Static,EFCore backend
    class BgServices workers
    class DB db
    class GitHub,AutoBuild ci
    class Container,Backend container
